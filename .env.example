# ── Base de données ───────────────────────────────────────────────────────────
POSTGRES_USER=ipregistry
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=ip_registry

# Construite automatiquement par docker-compose — remplacer si déploiement externe
DATABASE_URL=postgresql+psycopg2://ipregistry:changeme_strong_password@db:5432/ip_registry

# ── JWT RS256 ─────────────────────────────────────────────────────────────────
# Générer les clés : make keys
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
APP_NAME=RegistreIP-Canada
APP_VERSION=1.0.0

# ── Stockage ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
EXPORT_DIR=/data/exports

# ── APIs externes OPIC/CIPO (optionnel) ──────────────────────────────────────
CIPO_BASE_URL=https://www.ic.gc.ca/opic-cipo/cpd/eng
PCT_BASE_URL=https://www.wipo.int/pctdb/en
